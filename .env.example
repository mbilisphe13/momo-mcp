# Subscription key from https://momodeveloper.mtn.com after subscribing to a
# product (Collections, Disbursements or Remittances).
MOMO_SUBSCRIPTION_KEY=

# "sandbox" (default) or a production country: mtnghana, mtnuganda,
# mtnzambia, mtncameroon, mtnivorycoast, mtnbenin, mtncongo, mtnrwanda,
# mtnliberia, mtnswaziland, mtnguineaconakry, mtnsouthafrica.
# The host is derived from this and the two must always agree.
MOMO_TARGET_ENVIRONMENT=sandbox

# Required only when the target above is a production country. Without it a
# production target refuses to start rather than running unnoticed.
# MOMO_ALLOW_PRODUCTION=i-understand-this-moves-real-money

MOMO_PRODUCT=collection

# The sandbox only settles in EUR. In production use the local currency.
MOMO_CURRENCY=EUR

# Ceiling on a single payment request, in major units.
MOMO_MAX_AMOUNT=1000

# Filled in by calling momo_provision_sandbox_user once (sandbox), or issued
# by MTN (production).
MOMO_API_USER=
MOMO_API_KEY=
